local XRay = {}
local XRaySettings = {
    Enabled = false,
    Transparency = 0.7,
}

local OriginalParts = {}
local XRayThread = nil

local function MakeTransparent(part)
    if part:IsA("BasePart") and part.Transparency < 0.9 then
        OriginalParts[part] = part.Transparency
        part.Transparency = XRaySettings.Transparency
    end
end

local function RestorePart(part)
    if OriginalParts[part] then
        part.Transparency = OriginalParts[part]
        OriginalParts[part] = nil
    end
end

function XRay:Enable()
    XRaySettings.Enabled = true
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Transparency < 0.9 and not obj.Parent:IsDescendantOf(LocalPlayer.Character or {}) then
            MakeTransparent(obj)
        end
    end
    XRay.AddedConn = workspace.DescendantAdded:Connect(function(obj)
        if XRaySettings.Enabled and obj:IsA("BasePart") and obj.Transparency < 0.9 then
            MakeTransparent(obj)
        end
    end)
    print("✅ X-Ray enabled!")
end

function XRay:Disable()
    XRaySettings.Enabled = false
    if XRay.AddedConn then XRay.AddedConn:Disconnect() XRay.AddedConn = nil end
    for part in pairs(OriginalParts) do
        RestorePart(part)
    end
    print("❌ X-Ray disabled!")
end

