-- 5. TRACERS (линии к игрокам)
-- ═══════════════════════════════════════════════════════════════
local Tracers = {}
local TracerSettings = {
    Enabled = false,
    Color = Color3.fromRGB(255, 255, 255),
    Thickness = 1,
}

local TracerData = {}
local TracerThread = nil

local function CreateTracer(player)
    if player == LocalPlayer then return end
    if TracerData[player] then return end
    
    local line = Instance.new("Part")
    line.Name = "FlonsetTracer"
    line.Size = Vector3.new(0.1, 0.1, 1)
    line.Material = Enum.Material.Neon
    line.Color = TracerSettings.Color
    line.Transparency = 0
    line.CanCollide = false
    line.CanQuery = false
    line.Anchored = true
    line.Parent = workspace
    
    TracerData[player] = line
end

local function RemoveTracer(player)
    local line = TracerData[player]
    if line then pcall(function() line:Destroy() end) end
    TracerData[player] = nil
end

local function UpdateTracers()
    if not TracerSettings.Enabled then return end
    
    local camera = workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    for player, line in pairs(TracerData) do
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        if not root or not char then
            RemoveTracer(player)
            continue
        end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            RemoveTracer(player)
            continue
        end
        
        -- Позиция от камеры к игроку
        local startPos = camera.CFrame.Position
        local endPos = root.Position
        
        local distance = (endPos - startPos).Magnitude
        local midPoint = (startPos + endPos) / 2
        
        line.Size = Vector3.new(0.05, 0.05, distance)
        line.CFrame = CFrame.lookAt(startPos, endPos) * CFrame.new(0, 0, -distance / 2)
        line.Color = TracerSettings.Color
    end
end

function Tracers:Enable()
    TracerSettings.Enabled = true
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then CreateTracer(player) end
    end
    Tracers.AddedConn = Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function()
            task.wait(0.5)
            if TracerSettings.Enabled then CreateTracer(player) end
        end)
    end)
    Tracers.RemovingConn = Players.PlayerRemoving:Connect(function(player)
        RemoveTracer(player)
    end)
    TracerThread = RunService.Heartbeat:Connect(function() pcall(UpdateTracers) end)
    print("✅ Tracers enabled!")
end

function Tracers:Disable()
    TracerSettings.Enabled = false
    if Tracers.AddedConn then Tracers.AddedConn:Disconnect() Tracers.AddedConn = nil end
    if Tracers.RemovingConn then Tracers.RemovingConn:Disconnect() Tracers.RemovingConn = nil end
    if TracerThread then TracerThread:Disconnect() TracerThread = nil end
    for player in pairs(TracerData) do RemoveTracer(player) end
    print("❌ Tracers disabled!")
end

