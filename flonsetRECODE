                                shoot:FireServer(myRoot.CFrame, CFrame.new(myRoot.Position, root.Position))
                            end
                        end
                    end
                end
            end
        end)
    else
        if AuraThread then AuraThread:Disconnect() AuraThread = nil end
    end
end)
