local ChinaHat = {}
local HatSettings = {
    Enabled = false,
    Color = Color3.fromRGB(180, 100, 255),
    Transparency = 0.5,
    Size = 3,
}

local HatPart = nil
local HatThread = nil

local function CreateHat()
    if HatPart and HatPart.Parent then return end
    
    -- Создаем шляпу (конус)
    local hat = Instance.new("Part")
    hat.Name = "FlonsetChinaHat"
    hat.Size = Vector3.new(HatSettings.Size, 0.1, HatSettings.Size)
    hat.Material = Enum.Material.Neon
    hat.Color = HatSettings.Color
    hat.Transparency = HatSettings.Transparency
    hat.CanCollide = false
    hat.CanQuery = false
    hat.Anchored = true
    hat.Parent = workspace
    
    -- Добавляем SpecialMesh для формы конуса
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Cone
    mesh.Scale = Vector3.new(1, 1, 1)
    mesh.Parent = hat
    
    HatPart = hat
end

local function UpdateHat()
    if not HatSettings.Enabled then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local head = char:FindFirstChild("Head")
    if not head then return end
    
    if HatPart and HatPart.Parent then
        -- Позиционируем над головой
        HatPart.CFrame = head.CFrame * CFrame.new(0, 2.5, 0)
        HatPart.Color = HatSettings.Color
        HatPart.Transparency = HatSettings.Transparency
        HatPart.Size = Vector3.new(HatSettings.Size, 0.1, HatSettings.Size)
    end
end

function ChinaHat:Enable()
    HatSettings.Enabled = true
    
    -- Создаем шляпу только для локального игрока
    CreateHat()
    
    HatThread = RunService.Heartbeat:Connect(function()
        pcall(UpdateHat)
    end)
    
    print("✅ China Hat enabled! (только для тебя)")
end

function ChinaHat:Disable()
    HatSettings.Enabled = false
    
    if HatThread then
        HatThread:Disconnect()
        HatThread = nil
    end
    
    if HatPart then
        pcall(function() HatPart:Destroy() end)
        HatPart = nil
    end
    
    print("❌ China Hat disabled!")
end

function ChinaHat:SetColor(color)
    HatSettings.Color = color
end

function ChinaHat:SetTransparency(value)
    HatSettings.Transparency = math.clamp(value, 0, 1)
end

function ChinaHat:SetSize(value)
    HatSettings.Size = math.clamp(value, 1, 10)
end

