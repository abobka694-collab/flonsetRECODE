local TabNames = {"GAME", "VISUALS", "PLAYER", "ANIMATIONS", "TARGET", "MISC", "INFO"}

for i, name in ipairs(TabNames) do
    local TabButton = Instance.new("TextButton")
    TabButton.Name = name
    TabButton.Size = UDim2.new(1, 0, 0, 36)
    TabButton.BackgroundColor3 = name == "PLAYER" and COLORS.AccentDark or COLORS.Sidebar
    TabButton.Text = "  " .. name
    TabButton.TextColor3 = name == "PLAYER" and Color3.fromRGB(255, 255, 255) or COLORS.TextDim
    TabButton.TextSize = 12
    TabButton.Font = Enum.Font.GothamBold
    TabButton.TextXAlignment = Enum.TextXAlignment.Left
    TabButton.BorderSizePixel = 0
    TabButton.Parent = Sidebar
    
    local TabCorner = Instance.new("UICorner")
    TabCorner.CornerRadius = UDim.new(0, 6)
    TabCorner.Parent = TabButton
    
    Tabs[name] = { Button = TabButton }
    
    TabButton.MouseButton1Click:Connect(function()
        if ActiveTab == name then return end
        
        if ActiveTab and Tabs[ActiveTab] then
            Tabs[ActiveTab].Button.BackgroundColor3 = COLORS.Sidebar
            Tabs[ActiveTab].Button.TextColor3 = COLORS.TextDim
        end
        
        TabButton.BackgroundColor3 = COLORS.AccentDark
        TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        ActiveTab = name
        
        -- Показываем контент вкладки
        for tabName, tabData in pairs(Tabs) do
            if tabData.Content then
                tabData.Content.Visible = (tabName == name)
            end
        end
    end)
    
    TabButton.MouseEnter:Connect(function()
        if ActiveTab ~= name then
            TabButton.BackgroundColor3 = COLORS.Hover
        end
    end)
    TabButton.MouseLeave:Connect(function()
        if ActiveTab ~= name then
            TabButton.BackgroundColor3 = COLORS.Sidebar
        end
    end)
end

