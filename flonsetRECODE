local ChinaHat = {}
local HatSettings = {
    Enabled = false,
    Color = Color3.fromRGB(180, 100, 255), -- Фиолетовый
    Transparency = 0.5,
    Size = 3,
}

local HatData = {}
local HatThread = nil

local function CreateHat(player)
    if player == LocalPlayer then return end
    if HatData[player] then return end
    
    local char = player.Character
    if not char then return end
    
    local head = char:FindFirstChild("Head")
    if not head then return end
    
    -- Создаем шляпу (конус)
    local hat = Instance.new("Part")
    hat.Name = "FlonsetHat"
    hat.Size = Vector3.new(HatSettings.Size, 0.3, HatSettings.Size)
    hat.Shape = Enum.PartType.Cylinder
    hat.Material = Enum.Material.Neon
    hat.Color = HatSettings.Color
    hat.Transparency = HatSettings.Transparency
    hat.CanCollide = false
    hat.CanQuery = false
    hat.Anchored = true
    hat.Parent = workspace
    
    -- Позиционируем над головой
    hat.CFrame = head.CFrame * CFrame.new(0, 2.5, 0) * CFrame.Angles(0, 0, math.rad(90))
    
    HatData[player] = {
        hat = hat,
        head = head,
    }
end

local function RemoveHat(player)
    local data = HatData[player]
    if not data then return end
    
    if data.hat then
        pcall(function() data.hat:Destroy() end)
    end
    
    HatData[player] = nil
end

local function UpdateHats()
    if not HatSettings.Enabled then return end
    
    for player, data in pairs(HatData) do
        local char = player.Character
        local head = char and char:FindFirstChild("Head")
        
        if not head or not char then
            RemoveHat(player)
            continue
        end
        
        -- Обновляем позицию шляпы
        if data.hat and data.hat.Parent then
            data.hat.CFrame = head.CFrame * CFrame.new(0, 2.5, 0) * CFrame.Angles(0, 0, math.rad(90))
            data.hat.Color = HatSettings.Color
            data.hat.Transparency = HatSettings.Transparency
        end
    end
end

function ChinaHat:Enable()
    HatSettings.Enabled = true
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            CreateHat(player)
        end
    end
    
    ChinaHat.PlayerAddedConn = Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function()
            task.wait(0.5)
            if HatSettings.Enabled then
                CreateHat(player)
            end
        end)
    end)
    
    ChinaHat.PlayerRemovingConn = Players.PlayerRemoving:Connect(function(player)
        RemoveHat(player)
    end)
    
    HatThread = RunService.Heartbeat:Connect(function()
        pcall(UpdateHats)
    end)
    
    print("✅ China Hat enabled!")
end

function ChinaHat:Disable()
    HatSettings.Enabled = false
    
    if ChinaHat.PlayerAddedConn then
        ChinaHat.PlayerAddedConn:Disconnect()
        ChinaHat.PlayerAddedConn = nil
    end
    
    if ChinaHat.PlayerRemovingConn then
        ChinaHat.PlayerRemovingConn:Disconnect()
        ChinaHat.PlayerRemovingConn = nil
    end
    
    if HatThread then
        HatThread:Disconnect()
        HatThread = nil
    end
    
    for player in pairs(HatData) do
        RemoveHat(player)
    end
    
    print("❌ China Hat disabled!")
end

function ChinaHat:SetColor(color)
    HatSettings.Color = color
end

function ChinaHat:SetTransparency(value)
    HatSettings.Transparency = math.clamp(value, 0, 1)
end

function ChinaHat:SetSize(value)
    HatSettings.Size = math.clamp(value, 1, 10)
end

