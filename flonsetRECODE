-- Auto Shoot
local AutoShootSettings = { Enabled = false, Delay = 0.1 }
local AutoShootThread = nil
local LastShot = 0

CreateToggle(Tabs["COMBAT"].Content, "Auto Shoot", false, function(v)
    AutoShootSettings.Enabled = v
    if v then
        AutoShootThread = RunService.Heartbeat:Connect(function()
            if not AutoShootSettings.Enabled then return end
            local now = tick()
            if now - LastShot < AutoShootSettings.Delay then return end
            local myChar = LocalPlayer.Character
            local gun = myChar and myChar:FindFirstChild("Gun")
            if not gun then
                local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
                gun = backpack and backpack:FindFirstChild("Gun")
            end
            if gun then
                local shoot = gun:FindFirstChild("Shoot")
                if shoot and shoot:IsA("RemoteEvent") then
                    local camera = workspace.CurrentCamera
                    shoot:FireServer(camera.CFrame, camera.CFrame * CFrame.new(0, 0, -100))
                    LastShot = now
                end
            end
        end)
    else
        if AutoShootThread then AutoShootThread:Disconnect() AutoShootThread = nil end
    end
end)

