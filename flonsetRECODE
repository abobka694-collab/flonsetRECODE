-- Gun ESP
CreateSectionLabel(Tabs["VISUALS"].Content, "🔫 GUN ESP")
local GunESPSettings = { Enabled = false, Color = Color3.fromRGB(255, 215, 0), MaxDistance = 500 }
local GunESP_Data = {}
local GunESPThread = nil

local function GetGunPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true) end
    return obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart", true)
end

local function IsInCharacter(obj)
    local node = obj.Parent
    while node and node ~= workspace do
        if node:IsA("Model") and Players:GetPlayerFromCharacter(node) then return true end
        node = node.Parent
    end
    return false
end

local function CreateGunESP(obj)
    if GunESP_Data[obj] then return end
    if not obj or not obj.Parent then return end
    if IsInCharacter(obj) then return end
    local part = GetGunPart(obj)
    if not part then return end
    local data = { highlight = nil, billboard = nil }
    local highlight = Instance.new("Highlight")
    highlight.Name = "FlonsetGunHL"
    highlight.Adornee = obj
    highlight.FillTransparency = 0.7
    highlight.OutlineTransparency = 0
    highlight.FillColor = GunESPSettings.Color
    highlight.OutlineColor = GunESPSettings.Color
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = true
    highlight.Parent = CoreGui
    data.highlight = highlight
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "FlonsetGunBB"
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 100, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.ResetOnSpawn = false
    billboard.Parent = CoreGui
    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = "🔫 GUN"
    txt.TextColor3 = GunESPSettings.Color
    txt.TextStrokeTransparency = 0
    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 16
    txt.Parent = billboard
    data.billboard = billboard
    GunESP_Data[obj] = data
end

local function RemoveGunESP(obj)
    local data = GunESP_Data[obj]
    if not data then return end
    if data.highlight then pcall(function() data.highlight:Destroy() end) end
    if data.billboard then pcall(function() data.billboard:Destroy() end) end
    GunESP_Data[obj] = nil
end

local function UpdateGunESP()
    if not GunESPSettings.Enabled then return end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for obj, data in pairs(GunESP_Data) do
        if not obj or not obj.Parent or IsInCharacter(obj) then
            RemoveGunESP(obj)
            continue
        end
        local part = GetGunPart(obj)
        if not part or not part.Parent then
            RemoveGunESP(obj)
            continue
        end
        if myRoot then
            local dist = (part.Position - myRoot.Position).Magnitude
            if dist > GunESPSettings.MaxDistance then
                if data.highlight then data.highlight.Enabled = false end
                if data.billboard then data.billboard.Enabled = false end
            else
                if data.highlight then
                    data.highlight.Adornee = obj
                    data.highlight.FillColor = GunESPSettings.Color
                    data.highlight.OutlineColor = GunESPSettings.Color
                    data.highlight.Enabled = true
                end
                if data.billboard then
                    data.billboard.Adornee = part
                    data.billboard.Enabled = true
                end
            end
        end
    end
end

CreateToggle(Tabs["VISUALS"].Content, "Gun ESP", false, function(v)
    GunESPSettings.Enabled = v
    if v then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "GunDrop" and (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Tool")) and not IsInCharacter(obj) then
                CreateGunESP(obj)
            end
        end
        GunESPThread = RunService.Heartbeat:Connect(function() pcall(UpdateGunESP) end)
    else
        if GunESPThread then GunESPThread:Disconnect() GunESPThread = nil end
        for obj in pairs(GunESP_Data) do RemoveGunESP(obj) end
    end
end)

