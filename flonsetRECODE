    if GlowData[player] then return end
    
    local char = player.Character
    if not char then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "FlonsetGlow"
    highlight.Adornee = char
    highlight.FillTransparency = GlowSettings.FillTransparency
    highlight.OutlineTransparency = 0
    highlight.FillColor = GlowSettings.Color
    highlight.OutlineColor = GlowSettings.Color
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = true
    highlight.Parent = CoreGui
    
    GlowData[player] = highlight
end

local function RemoveGlow(player)
    local highlight = GlowData[player]
    if highlight then
        pcall(function() highlight:Destroy() end)
    end
    GlowData[player] = nil
end

function PlayerGlow:Enable()
    GlowSettings.Enabled = true
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then CreateGlow(player) end
    end
    PlayerGlow.AddedConn = Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function()
