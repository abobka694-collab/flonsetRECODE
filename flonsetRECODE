    ToggleButton.MouseButton1Click:Connect(function()
        state = not state
        ToggleButton.BackgroundColor3 = state and COLORS.ToggleOn or COLORS.ToggleOff
        TweenService:Create(ToggleCircle, TweenInfo.new(0.2), {
            Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        }):Play()
        if settingsCallback then settingsCallback(state) end
    end)
    
    SettingsButton.MouseButton1Click:Connect(function()
        settingsOpen = not settingsOpen
        if settingsCallback then settingsCallback(state, settingsOpen) end
    end)
    
    ToggleFrame.MouseEnter:Connect(function()
        ToggleFrame.BackgroundColor3 = COLORS.Hover
    end)
    ToggleFrame.MouseLeave:Connect(function()
        ToggleFrame.BackgroundColor3 = COLORS.Section
    end)
    
    SettingsButton.MouseEnter:Connect(function()
        SettingsButton.BackgroundColor3 = COLORS.Hover
        SettingsButton.TextColor3 = COLORS.Accent
    end)
    SettingsButton.MouseLeave:Connect(function()
        SettingsButton.BackgroundColor3 = COLORS.Section
        SettingsButton.TextColor3 = COLORS.TextDim
    end)
end

