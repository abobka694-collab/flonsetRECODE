    if PlayerGlow.AddedConn then PlayerGlow.AddedConn:Disconnect() PlayerGlow.AddedConn = nil end
    if PlayerGlow.RemovingConn then PlayerGlow.RemovingConn:Disconnect() PlayerGlow.RemovingConn = nil end
    for player in pairs(GlowData) do RemoveGlow(player) end
    print("❌ Player Glow disabled!")
end

